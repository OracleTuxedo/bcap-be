<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">

    <Appenders>
        <Console name="LogToConsole" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %c{1}:%L - %msg%n"/>
        </Console>

        <RollingFile
            name="DailyFile"
            fileName="logs/app.log"
            filePattern="logs/app-%d{yyyy-MM-dd}.log"
        >
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %c{1}:%L - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <RollingFile
            name="DailyScreenFile"
            fileName="logs/app_screen.log"
            filePattern="logs/app_screen_%d{yyyy-MM-dd}.log"
        >
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %c{1}:%L - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <Routing name="RoutingAppender">
            <Routes pattern="${ctx:className}">
                <Route>
                    <!-- RollingFile Appender for each dynamically created route -->
                    <RollingFile
                        name="DynamicFileAppender"
                        fileName="logs/${ctx:className}.log"
                        filePattern="logs/${ctx:className}-%d{yyyy-MM-dd}-%i.log">
                        <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %c{1}:%L - %msg%n"/>
                        <Policies>
                            <!-- Time-based rollover for daily logs -->
                            <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                            <!-- Size-based rollover when the file reaches 10MB -->
                            <SizeBasedTriggeringPolicy size="1MB"/>
                        </Policies>
                        <!-- Strategy to retain up to 30 rolled-over log files -->
                        <DefaultRolloverStrategy max="30"/>
                    </RollingFile>
                </Route>
            </Routes>
        </Routing>
    </Appenders>

    <Loggers>
        <Logger name="maas.bcap.screen" level="info" additivity="false">
            <AppenderRef ref="RoutingAppender"/>
<!--            <AppenderRef ref="RoutingPerClass"/>-->
<!--            <AppenderRef ref="DailyScreenFile"/>-->
        </Logger>

        <Root level="warn">
            <AppenderRef ref="LogToConsole"/>
            <AppenderRef ref="DailyFile"/>

        </Root>
    </Loggers>
</Configuration>

